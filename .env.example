# Plantilla de variables de entorno. Solo nombres: nunca escribir valores aquí.
# Copiar a .env.local (ignorado por git) y completar en local.

# --- Públicas (llegan al navegador; jamás poner secretos) ---
# URL base de la API a la que se conecta el front.
NEXT_PUBLIC_API_URL=
# Nube pública de Cloudinary para las imágenes.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Clave publicable de Stripe (la pública, nunca la secreta).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- De servidor existentes (pendiente de retirar: NP-01, NP-02, NP-10) ---
# Secreto de firma del JWT que usa proxy.ts.
JWT_SECRET=
# Conexión a la base de datos que usan los route handlers de app/api.
DATABASE_URL=
# Respaldos en Google Drive.
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_DRIVE_FOLDER_ID=

# --- Pruebas ---
# Secreto ficticio solo para firmar el JWT de las pruebas E2E.
E2E_JWT_SECRET=
