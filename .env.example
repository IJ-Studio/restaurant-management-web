# Plantilla de variables de entorno. Solo nombres: nunca escribir valores aquí.
# Copiar a .env.local (ignorado por git) y completar en local.

# --- Públicas (llegan al navegador; jamás poner secretos) ---
# El build se detiene si falta alguna (lib/config/entorno-publico.ts).
# URL base de la API a la que se conecta el front. En producción debe ser https.
NEXT_PUBLIC_API_URL=
# Nube pública de Cloudinary para las imágenes.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Clave publicable de Stripe (pk_..., nunca la secreta).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- De servidor ---
# Secreto con el que proxy.ts y lib/session.ts verifican el JWT de sesión. Debe ser el mismo del API.
JWT_SECRET=

# --- Pruebas (opcionales) ---
# Secreto ficticio solo para firmar el JWT de las pruebas E2E.
E2E_JWT_SECRET=
# "dev" para correr las E2E con next dev; vacío = build + next start.
# E2E_MODO=
# Cualquier valor activa también Microsoft Edge en las E2E.
# E2E_EDGE=
# URL de la web para las pruebas contra el API real (playwright.real.config.ts). Normalmente http://localhost:3100.
# E2E_REAL_URL=
# Carpeta donde guardar la línea base de las E2E (fuera de test-results/).
# LINEA_BASE_DIR=

# --- Herramientas de rendimiento (scripts/medir-lighthouse.mjs y comparar-rendimiento.mjs) ---
# Ruta de Chrome/Chromium; si falta, se usa el de Playwright (PLAYWRIGHT_BROWSERS_PATH).
# CHROME_PATH=
# Carpeta de resultados de comparar-rendimiento.
# RENDIMIENTO_DIR=
